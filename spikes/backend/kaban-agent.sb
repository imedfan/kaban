;; kaban-agent.sb — шаблон профиля Seatbelt (sandbox-exec) для cursor-agent и его
;; инструментов (§8.2 п.3 архитектуры Kaban). Шаблон спайка 6.
;;
;; Плейсхолдеры вида @@ИМЯ@@ подставляет spike6-seatbelt.sh (`lib/kspike.py render-sb`):
;;   HOME       реальный путь домашнего каталога
;;   CLONE      клон задачи (единственное место записи из проектов)
;;   TMPDIR     выделенный per-run temp (не общий системный $TMPDIR)
;;   CACHEDIR   выделенный per-run cache (не общий пользовательский cache)
;;   MCP_PORT   порт MCP-сервера доски на 127.0.0.1
;;   EXTRA_WRITE       служебные каталоги cursor-agent (найдены в спайке)
;;   EXTRA_DENY_READ   дополнительные запреты чтения
;;   EXTRA_DENY_WRITE  дополнительные запреты записи
;;
;; Порядок allow/deny проверен только synthetic probe на указанной macOS версии,
;; не является обещанием стабильного SBPL API. Launcher передаёт физические пути.
;; CLONE/TMPDIR/CACHEDIR должны быть отдельными sibling каталогами; их общий
;; родитель не должен получать запись. EXTRA_WRITE не должен разрешать предков клона.
;; Ограничение SBPL: в (remote ip "host:port") host может быть только "*" или "localhost",
;; поэтому allowlist внешних хостов для команд агента делается прокси, а не профилем.

(version 1)

;; Experimental deny-default candidate, verified only by the bounded synthetic probe.
;; Not production-ready: real cursor-agent/runtime compatibility and macOS 26 are pending.
;; Read/process permissions remain broad; this candidate only investigates protected writes.
(deny default)
(allow file-read*)
(allow process*)
(allow sysctl-read)
(allow mach-lookup)

;; ---------- Запись: запрещена везде ...
(deny file-write*)

;; ... кроме клона задачи, временных каталогов, устройств и служебных каталогов CLI
(allow file-write*
  (subpath "@@CLONE@@")
  (subpath "@@TMPDIR@@")
  (subpath "@@CACHEDIR@@")
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/tty")
  (literal "/dev/ptmx")
  (literal "/dev/dtracehelper")
  (regex #"^/dev/fd/")
  (regex #"^/dev/ttys[0-9]+$")
@@EXTRA_WRITE@@
)

;; ---------- Protected clone metadata, after every write grant (including EXTRA_WRITE).
;; Path denies alone do not protect descendants when their ancestor is renamed.
;; Block unlink/rename of the clone root and .git ancestor as well as protected trees.
(deny file-write*
  (subpath "@@CLONE@@/.git/config")
  (subpath "@@CLONE@@/.git/hooks")
  (subpath "@@CLONE@@/.git/info")
  (subpath "@@CLONE@@/.kaban")
)
(deny file-write-unlink
  (literal "@@CLONE@@")
  (literal "@@CLONE@@/.git")
)

;; ---------- Жёсткие запреты записи (поверх разрешений выше)
(deny file-write*
  (literal "@@HOME@@/.gitconfig")
  (subpath "@@HOME@@/.ssh")
  (literal "@@HOME@@/.cursor/mcp.json")
  (subpath "@@HOME@@/Library/Application Support/Kaban")
  (subpath "@@HOME@@/Library/LaunchAgents")
@@EXTRA_DENY_WRITE@@
)

;; ---------- Чтение секретов запрещено: ключи SSH и globalStorage Cursor IDE (токен IDE)
(deny file-read*
  (subpath "@@HOME@@/.ssh")
  (subpath "@@HOME@@/Library/Application Support/Cursor/User/globalStorage")
@@EXTRA_DENY_READ@@
)

;; ---------- Network remains unavailable except the explicit board MCP port.
;; No external-host allowance is asserted by this experimental profile.
(allow network-outbound (remote ip "localhost:@@MCP_PORT@@"))
